{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=fieldflow;Username=fieldflow;Password=<via-variavel-de-ambiente>"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fieldflow-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "BusinessCalendar": {
    "TimeZoneId": "America/Sao_Paulo",
    "WorkdayStart": "08:00",
    "WorkdayEnd": "18:00",
    "WorkingDays": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ]
  },
  "Seed": {
    "DemoData": false
  },
  "AllowedHosts": "*"
}
